[Unit]
Description=YazSes voice dictation daemon
Documentation=https://github.com/MSKazemi/yazses
After=graphical-session.target sound.target
Wants=graphical-session.target
# Self-healing with a crash-loop bound: restart on failure, but if it fails 5
# times within 60s (e.g. a persistent bad config or missing audio stack) stop
# retrying so it doesn't spin forever. `yazses doctor` then explains why.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/yazses-daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Pass the X11 display from the desktop session so xdotool/xclip can inject text.
# Requires the session to export DISPLAY/XAUTHORITY to the systemd user manager
# (GNOME/GDM does this automatically; run install-local.sh for a guaranteed fallback).
PassEnvironment=DISPLAY XAUTHORITY

[Install]
WantedBy=graphical-session.target
