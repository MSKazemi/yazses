{
  "unit": "postprocess.spacing",
  "contract_version": "7.1.0",
  "source": "src/yazses/postprocess/spacing.py::continuation_prefix",
  "cases": [
    {
      "id": "no-recent-injection",
      "description": "a fresh burst gets no separator",
      "options": {
        "had_recent_injection": false
      },
      "input": "hello",
      "expected": ""
    },
    {
      "id": "continues-recent-burst",
      "description": "a burst continuing a recent one is separated by a single space",
      "options": {
        "had_recent_injection": true
      },
      "input": "hello",
      "expected": " "
    },
    {
      "id": "suppressed-before-full-stop",
      "description": "no space before closing punctuation — otherwise you get 'word .'",
      "options": {
        "had_recent_injection": true
      },
      "input": ".",
      "expected": ""
    },
    {
      "id": "suppressed-before-comma",
      "description": "same for a comma",
      "options": {
        "had_recent_injection": true
      },
      "input": ", and then",
      "expected": ""
    },
    {
      "id": "suppressed-before-question-mark",
      "description": "same for a question mark",
      "options": {
        "had_recent_injection": true
      },
      "input": "?",
      "expected": ""
    },
    {
      "id": "suppressed-before-closing-bracket",
      "description": "same for ) ] }",
      "options": {
        "had_recent_injection": true
      },
      "input": ") done",
      "expected": ""
    },
    {
      "id": "suppressed-before-ellipsis",
      "description": "same for the ellipsis character",
      "options": {
        "had_recent_injection": true
      },
      "input": "… later",
      "expected": ""
    },
    {
      "id": "suppressed-before-percent",
      "description": "same for a percent sign",
      "options": {
        "had_recent_injection": true
      },
      "input": "% of users",
      "expected": ""
    },
    {
      "id": "not-suppressed-before-opening-quote",
      "description": "an opening delimiter still wants a leading space — deliberate asymmetry with closing punctuation",
      "options": {
        "had_recent_injection": true
      },
      "input": "\"quoted",
      "expected": " "
    },
    {
      "id": "not-suppressed-before-opening-paren",
      "description": "a new clause starting with ( wants its space",
      "options": {
        "had_recent_injection": true
      },
      "input": "(aside)",
      "expected": " "
    },
    {
      "id": "empty-text-continuing",
      "description": "an empty burst after a recent injection",
      "options": {
        "had_recent_injection": true
      },
      "input": "",
      "expected": ""
    },
    {
      "id": "empty-text-fresh",
      "description": "an empty burst with no recent injection",
      "options": {
        "had_recent_injection": false
      },
      "input": "",
      "expected": ""
    },
    {
      "id": "leading-space-already-present",
      "description": "the separator is added blind, so text that already begins with a space would be double-spaced. Unreachable in the real pipeline (clean_text strips leading whitespace first) — pinned so a port that calls the units in a different order knows the ordering matters",
      "options": {
        "had_recent_injection": true
      },
      "input": " already spaced",
      "expected": " "
    },
    {
      "id": "rtl-persian-continuing",
      "description": "RTL continuation still gets its separator",
      "options": {
        "had_recent_injection": true
      },
      "input": "سلام",
      "expected": " "
    },
    {
      "id": "persian-comma-start-suppressed",
      "description": "a burst opening with the Persian comma U+060C hugs the previous burst exactly like an ASCII comma — the pre-7.0.0 contract leaked a stray visible space here",
      "options": {
        "had_recent_injection": true
      },
      "input": "، بعداً",
      "expected": ""
    },
    {
      "id": "persian-question-mark-start-suppressed",
      "description": "U+061F suppresses the separator like its ASCII cousin",
      "options": {
        "had_recent_injection": true
      },
      "input": "؟ شاید",
      "expected": ""
    },
    {
      "id": "persian-semicolon-start-suppressed",
      "description": "U+061B suppresses the separator like its ASCII cousin",
      "options": {
        "had_recent_injection": true
      },
      "input": "؛ سپس",
      "expected": ""
    },
    {
      "id": "closing-guillemet-start-suppressed",
      "description": "U+00BB closes; it suppresses like ) ] } while U+00AB still counts as an opening delimiter",
      "options": {
        "had_recent_injection": true
      },
      "input": "» بعداً",
      "expected": ""
    },
    {
      "id": "zwnj-start-word-still-gets-space",
      "description": "the probe skips invisible format characters, but a leading ZWNJ in front of a word still gets the separator: joining across a boundary ZWNJ is a normalisation decision (postprocess.persian_text strips boundary ZWNJ), not a spacing one",
      "options": {
        "had_recent_injection": true
      },
      "input": "‌سلام",
      "expected": " "
    },
    {
      "id": "bidi-control-start-word-still-gets-space",
      "description": "an RLE embedding character before a word behaves like the ZWNJ case: invisible, so it neither suppresses nor hides the separator — adversarial input must not make a port invent a special case",
      "options": {
        "had_recent_injection": true
      },
      "input": "‫سلام",
      "expected": " "
    },
    {
      "id": "zwnj-then-persian-comma-suppressed",
      "description": "the probe looks past the leading ZWNJ and finds the Persian comma: suppression still applies even though text[0] is invisible — the pre-7.0.0 probe saw only text[0] and leaked the space",
      "options": {
        "had_recent_injection": true
      },
      "input": "‌، بعداً",
      "expected": ""
    },
    {
      "id": "bidi-control-then-comma-suppressed",
      "description": "an RLE control before an ASCII comma: the first visible character decides, so the separator is suppressed",
      "options": {
        "had_recent_injection": true
      },
      "input": "‫, done",
      "expected": ""
    },
    {
      "id": "fullwidth-comma-start-suppressed",
      "description": "a burst opening with ， hugs the previous burst like an ASCII comma — before 7.1.0 it was typed as ' ，'",
      "options": {
        "had_recent_injection": true
      },
      "input": "，然后我们继续",
      "expected": ""
    },
    {
      "id": "fullwidth-full-stop-start-suppressed",
      "description": "。 likewise",
      "options": {
        "had_recent_injection": true
      },
      "input": "。",
      "expected": ""
    },
    {
      "id": "fullwidth-question-mark-start-suppressed",
      "description": "？ likewise",
      "options": {
        "had_recent_injection": true
      },
      "input": "？好吗",
      "expected": ""
    },
    {
      "id": "ideographic-enumeration-comma-start-suppressed",
      "description": "、 (the enumeration comma) likewise",
      "options": {
        "had_recent_injection": true
      },
      "input": "、香蕉和橙子",
      "expected": ""
    },
    {
      "id": "fullwidth-opening-bracket-start-suppressed",
      "description": "unlike an ASCII '(' or a straight quote, a full-width opening mark such as 「 also takes no space: the glyph carries its own spacing",
      "options": {
        "had_recent_injection": true
      },
      "input": "「引用」",
      "expected": ""
    },
    {
      "id": "han-after-han-no-space",
      "description": "two Han clauses: no space at the seam — before 7.1.0 every second burst within the continuation window began with one",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "界"
      },
      "input": "今天测试。",
      "expected": ""
    },
    {
      "id": "han-after-fullwidth-stop-no-space",
      "description": "a burst after one that ended in 。 takes no space",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "。"
      },
      "input": "今天测试。",
      "expected": ""
    },
    {
      "id": "latin-after-fullwidth-comma-no-space",
      "description": "full-width punctuation carries its own spacing on both sides, so a Latin burst after ， takes none either",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "，"
      },
      "input": "YazSes 很好用",
      "expected": ""
    },
    {
      "id": "latin-after-han-keeps-space",
      "description": "a Han-Latin seam keeps its space ('测试 YazSes'), the common convention for mixed text and what the pre-7.1.0 code did",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "试"
      },
      "input": "YazSes",
      "expected": " "
    },
    {
      "id": "han-after-latin-keeps-space",
      "description": "and the other way round",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "s"
      },
      "input": "今天测试",
      "expected": " "
    },
    {
      "id": "english-unaffected-by-previous-tail",
      "description": "an English seam is unchanged by knowing the previous tail",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "d"
      },
      "input": "hello",
      "expected": " "
    },
    {
      "id": "previous-tail-ignored-without-recent-injection",
      "description": "a fresh burst still gets nothing, whatever came before",
      "options": {
        "had_recent_injection": false,
        "previous_tail": "界"
      },
      "input": "今天测试",
      "expected": ""
    },
    {
      "id": "astral-han-after-han-no-space",
      "description": "an extension-B ideograph (outside the BMP) is Han too: a UTF-16 port must test the code point, not the first char",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "去"
      },
      "input": "𠮷野家",
      "expected": ""
    },
    {
      "id": "kana-after-han-no-space",
      "description": "Japanese kana is unspaced like Han",
      "options": {
        "had_recent_injection": true,
        "previous_tail": "日"
      },
      "input": "ありがとう",
      "expected": ""
    }
  ]
}
