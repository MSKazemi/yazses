[0.835, "o", "\u001b[1m                                                                               \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1myazses [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                    \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                               \u001b[0m\r\n Local, offline voice dictation \u2014 hold a key, speak, release.                  \r\n                                                                               \r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-version\u001b[0m             \u001b[1;32m-V\u001b[0m        Show version and exit.                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-install\u001b[0m\u001b[1;36m-completion\u001b[0m            Install completion for the current shell.   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-show\u001b[0m\u001b[1;36m-completion\u001b[0m               Show completion for the current shell, to   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                 copy it or customize the installation.      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                \u001b[1;32m-h\u001b[0m        Show this message and exit.                 \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Updates & maintenance \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mabout       \u001b[0m\u001b[1;36m \u001b[0m Show author, version, links, and where to report issues or    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m request features.                                             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mupdate      \u001b[0m\u001b[1;36m \u001b[0m Check for a newer YazSes and update it (snap / uv tool / pipx \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m / pip).                                                       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Daemon \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mstart       \u001b[0m\u001b[1;36m \u001b[0m Start the YazSes daemon (restarts cleanly if one is already   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m running).                                                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mrestart     \u001b[0m\u001b[1;36m \u001b[0m Restart the daemon \u2014 kills any stray/duplicate daemons and    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m starts exactly one.                                           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mtray        \u001b[0m\u001b[1;36m \u001b[0m Show the system-tray / top-bar icon with a click-menu (mic +  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m daemon controls).                                             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36msettings    \u001b[0m\u001b[1;36m \u001b[0m Open the Settings window \u2014 every capability as a toggle,      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m grouped by category.                                          \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mstop        \u001b[0m\u001b[1;36m \u001b[0m Stop the running daemon.                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mstatus      \u001b[0m\u001b[1;36m \u001b[0m Show daemon status. Queries the daemon over IPC when          \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m reachable.                                                    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mfeatures    \u001b[0m\u001b[1;36m \u001b[0m See capabilities and turn them on/off (no config-editing      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m needed).                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Setup & calibration \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mverify      \u001b[0m\u001b[1;36m \u001b[0m Record, transcribe, and prove dictation works end to end on   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m this machine.                                                 \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mreport      \u001b[0m\u001b[1;36m \u001b[0m Collect a diagnostic report locally \u2014 nothing is uploaded.    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mquickstart  \u001b[0m\u001b[1;36m \u001b[0m Get dictating in 3 steps \u2014 a friendly guide tailored to your  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m machine.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mdoctor      \u001b[0m\u001b[1;36m \u001b[0m Check system prerequisites and report what's OK / missing.    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mmic-level   \u001b[0m\u001b[1;36m \u001b[0m Measure mic speech level and recommend (or set) the VAD       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m threshold.                                                    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mlogs        \u001b[0m\u001b[1;36m \u001b[0m Show the daemon's diagnostic log (metadata only -- no         \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m dictated text).                                               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36msetup       \u001b[0m\u001b[1;36m \u001b[0m Provision all Linux runtime requirements so dictation works   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m out of the box.                                               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36menroll      \u001b[0m\u001b[1;36m \u001b[0m Run the accessibility enrollment wizard to calibrate VAD      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m thresholds.                                                   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36menroll-voice\u001b[0m\u001b[1;36m \u001b[0m Record a short voiceprint so YazSes can recognise your voice. \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mmodel       \u001b[0m\u001b[1;36m \u001b[0m Manage SLM intent-routing models (download / list).           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mvocab       \u001b[0m\u001b[1;36m \u001b[0m Manage your personal dictionary (words STT mis-hears).        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mautostart   \u001b[0m\u001b[1;36m \u001b[0m Start YazSes automatically at login, so it survives a reboot. \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36maudio       \u001b[0m\u001b[1;36m \u001b[0m See and pin the input microphone (fixes a mic that silently   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m switches).                                                    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mhotkey      \u001b[0m\u001b[1;36m \u001b[0m Change the key you hold to talk.                              \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mgaze        \u001b[0m\u001b[1;36m \u001b[0m Aim dictation with your gaze \u2014 type into whichever pane you   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m look at.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Dictation & correction \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36minject      \u001b[0m\u001b[1;36m \u001b[0m Type text into the focused window without recording (tests    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m the injector).                                                \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36msay         \u001b[0m\u001b[1;36m \u001b[0m Speak text aloud with the built-in offline voice.             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36moverlay     \u001b[0m\u001b[1;36m \u001b[0m Run the sonar voice-activity overlay (needs the `overlay`     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m extra: PySide6).                                              \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mreflow      \u001b[0m\u001b[1;36m \u001b[0m Reflow a monologue into a bulleted outline \u2014 fully offline.   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mtable       \u001b[0m\u001b[1;36m \u001b[0m Turn spoken rows into delimited (CSV) lines \u2014 fully offline.  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mshellpipe   \u001b[0m\u001b[1;36m \u001b[0m Render a spoken pipeline into a shell command \u2014 fully         \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m offline.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mbraille     \u001b[0m\u001b[1;36m \u001b[0m Translate text to Unicode Braille (UEB subset) \u2014 fully        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m offline.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcase        \u001b[0m\u001b[1;36m \u001b[0m Recase text to a naming convention \u2014 fully offline.           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mscreenplay  \u001b[0m\u001b[1;36m \u001b[0m Format dictated lines as Fountain screenplay markup \u2014 fully   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m offline.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mfindreplace \u001b[0m\u001b[1;36m \u001b[0m Apply a spoken find-and-replace to text \u2014 fully offline.      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mchords      \u001b[0m\u001b[1;36m \u001b[0m Turn a spoken key chord into injectable key combos \u2014 fully    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m offline.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mwordfind    \u001b[0m\u001b[1;36m \u001b[0m Reverse dictionary: describe a word and get candidates \u2014      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m fully offline.                                                \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcite        \u001b[0m\u001b[1;36m \u001b[0m Resolve a spoken 'author year' reference against a .bib file  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m \u2014 fully offline.                                              \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mslotfill    \u001b[0m\u001b[1;36m \u001b[0m Extract structured fields from one utterance by a schema \u2014    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m fully offline.                                                \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mpunch-in    \u001b[0m\u001b[1;36m \u001b[0m Correct the last dictation by re-speaking just the wrong      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m phrase.                                                       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mtranscribe  \u001b[0m\u001b[1;36m \u001b[0m Transcribe an audio file to text \u2014 fully offline, on your     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m machine.                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mtest        \u001b[0m\u001b[1;36m \u001b[0m End-to-end self-test: confirm the injector works without      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m speaking.                                                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mmeeting     \u001b[0m\u001b[1;36m \u001b[0m Hands-free meeting recording with who-said-what speaker       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m labels + notes.                                               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36macronyms    \u001b[0m\u001b[1;36m \u001b[0m Manage a persistent acronym glossary and expand acronyms in   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m text \u2014 offline.                                               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mwordgoal    \u001b[0m\u001b[1;36m \u001b[0m Track words written against a writing goal, across            \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m invocations \u2014 offline.                                        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcliphistory \u001b[0m\u001b[1;36m \u001b[0m A persistent clipboard history you can recall by voice-style  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m reference \u2014 offline.                                          \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36moutline     \u001b[0m\u001b[1;36m \u001b[0m Build a nested outline incrementally and render it to         \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m Markdown/OPML \u2014 offline.                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36msrs         \u001b[0m\u001b[1;36m \u001b[0m Capture facts as spaced-repetition flashcards and schedule    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m reviews (SM-2) \u2014 offline.                                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Remote \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mremote      \u001b[0m\u001b[1;36m \u001b[0m Forward voice typing to a remote host over SSH.               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u250c\u2500\u001b[0m\u001b[2m Learning & tuning \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u2510\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mmark-wrong  \u001b[0m\u001b[1;36m \u001b[0m Flag the last dictation as a misrecognition (a learning       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m signal).                                                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcoach       \u001b[0m\u001b[1;36m \u001b[0m Show private speaking-style analytics (filler rate,           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m words-per-minute, vocabulary).                                \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mrecall      \u001b[0m\u001b[1;36m \u001b[0m Search your past dictations.                                  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mscratch     \u001b[0m\u001b[1;36m \u001b[0m Show or clear your ambient scratch notes (spoken \"note to     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m self \u2026\").                                                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mtune        \u001b[0m\u001b[1;36m \u001b[0m Analyze the learning corpus and propose accuracy              \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m             \u001b[0m improvements.                                                 \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcorpus      \u001b[0m\u001b[1;36m \u001b[0m Inspect or clear the local learning corpus.                   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n                                                                               \r\n \u001b[1mExamples\u001b[0m                                                                      \r\n                                                                               \r\n yazses quickstart            new here? the 3 steps to get dictating           \r\n                                                                               \r\n yazses start                 start dictating \u2014 hold the hotkey, speak,        \r\n release                                                                       \r\n                                                                               \r\n yazses status                is it running? show state, model, and hotkey     \r\n                                                                               \r\n yazses doctor                check mic, keyboard, and injection prerequisites \r\n                                                                               \r\n yazses mic-level \u001b[1;36m-\u001b[0m\u001b[1;36m-set\u001b[0m       calibrate the mic threshold to your voice        \r\n                                                                               \r\n yazses test                  type a test phrase to confirm injection works    \r\n                                                                               \r\n yazses features              browse every capability + what's on/off          \r\n                                                                               \r\n yazses features info \u001b[1;33m<name>\u001b[0m  what a capability does + a usage example         \r\n                                                                               \r\n \u001b[1mTab completion\u001b[0m                                                                \r\n                                                                               \r\n yazses \u001b[1;36m-\u001b[0m\u001b[1;36m-install\u001b[0m\u001b[1;36m-completion\u001b[0m  enable \u001b[1;33m<Tab>\u001b[0m completion for your shell           \r\n                                                                               \r\n yazses \u001b[1;36m-\u001b[0m\u001b[1;36m-show\u001b[0m\u001b[1;36m-completion\u001b[0m     print the completion script to inspect/customise \r\n                                                                               \r\n \u001b[1mHelp & contact\u001b[0m                                                                \r\n                                                                               \r\n yazses about                 author, links, and where to report issues        \r\n                                                                               \r\n Report a bug or request a feature: https://github.com/MSKazemi/yazses/issues  \r\n                                                                               \r\n Made by Mohsen Seyedkazemi Ardebili \u001b[1;33m<mohsen.seyedkazemi@gmail.com>\u001b[0m            \r\n                                                                               \r\n\r\n"]
