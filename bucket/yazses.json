{
    "version": "2.43.2",
    "description": "Offline voice dictation and speech-to-text - hold a key, speak, release. Runs on your own CPU with no cloud, no API key and no subscription.",
    "homepage": "https://mskazemi.com/yazses/",
    "license": "Apache-2.0",
    "notes": [
        "YazSes runs entirely on your machine. On first use it downloads a speech model (~141 MB) from Hugging Face; after that it needs no network at all.",
        "Launch the tray app from the Start Menu, or run 'yazses --help' in a new terminal.",
        "Windows builds are not code-signed yet, so SmartScreen may warn on first launch."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/MSKazemi/yazses/releases/download/v2.43.2/YazSes-2.43.2-windows-x64.exe#/setup.exe",
            "hash": "2bc44c47e2c4378f2359c22000784f001467efb8111a9459b480e891f5f7aded"
        }
    },
    "innosetup": true,
    "bin": [
        [
            "yazses-cli.exe",
            "yazses"
        ]
    ],
    "shortcuts": [
        [
            "YazSesApp.exe",
            "YazSes"
        ]
    ],
    "pre_uninstall": [
        "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$entry = (Get-ItemProperty -Path $run -Name 'YazSes' -ErrorAction SilentlyContinue).YazSes",
        "$appRoot = (Split-Path $dir -Parent) + '\\'",
        "if ($cmd -eq 'uninstall' -and $entry -and $entry.ToLower().Contains($appRoot.ToLower())) { Remove-ItemProperty -Path $run -Name 'YazSes' }"
    ],
    "checkver": {
        "github": "https://github.com/MSKazemi/yazses"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/MSKazemi/yazses/releases/download/v$version/YazSes-$version-windows-x64.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/MSKazemi/yazses/releases/download/v$version/SHA256SUMS.txt",
                    "regex": "$sha256\\s+YazSes-$version-windows-x64.exe"
                }
            }
        }
    }
}
