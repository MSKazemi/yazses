{
  "report_version": "1.0",
  "no_threshold_notice": "No product threshold, default or 'recommended' status follows from these numbers. Checked-in traces are synthetic and a threshold sweep only shows the phantom/recall trade-off on the trace it ran on. A facial switch is not recommended until false-activation evidence exists from real volunteer sessions across people (design/eye-control/ROADMAP.md P5.4, ADR-v2-150).",
  "zero_denominator_rule": "An empty trace is refused. A rate whose own denominator is zero is reported as {\"value\": null, \"reason\": ...}, never as 0.0: no non-deliberate time -> not_measured; no deliberate gestures -> not_measured; non-deliberate time with no usable reading -> tracking_unavailable.",
  "metric_definitions": {
    "false_activations": "switch starts outside every deliberate window (one per action, not per frame)",
    "false_activations_per_hour": "false_activations / (non-deliberate seconds / 3600); non-deliberate time is every sample outside a deliberate window, tracked or not",
    "recall": "deliberate intervals with at least one start in their window / deliberate intervals",
    "activation_latency_ms": "first start sample minus the deliberate interval's first sample, debounce included",
    "chatter": "more than one start inside one deliberate window"
  },
  "upper_bound_caveat": "Exact one-sided 95% Poisson upper bound on the rate, assuming independent events in a single session; real phantoms cluster (a long conversation, a bad lighting spell), so treat it as a floor on the uncertainty, not a guarantee.",
