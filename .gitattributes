# Byte-exact fixtures and traces: the determinism tests hash these files, and Git for Windows
# defaults to checking text out with CRLF, which made `test_the_checked_in_fixtures_use_unix_newlines_and_ascii`
# fail on the Windows runner. Pin them to LF on every OS.
tests/fixtures/eye_eval/** text eol=lf
tests/fixtures/eye_eval_runner/** text eol=lf
tests/fixtures/eye_eval_tasks/** text eol=lf
tests/fixtures/face_switch_traces/** text eol=lf
tests/fixtures/grounding_traces/** text eol=lf
tests/fixtures/face_switch_replay_report.json text eol=lf
tests/fixtures/grounding_replay_report.json text eol=lf
design/eye-control/validation-slots.json text eol=lf
design/eye-control/generated/** text eol=lf
design/publication/paper-v2/manuscript/generated/** text eol=lf
# The HCI lab's manifest records the SHA-256 of its fixtures and schema, so a Windows checkout must not
# rewrite their line endings.
examples/hci-hf-lab/** text eol=lf
# Vendored licence texts for add-on packs: the build copies them only when their SHA-256
# matches licence-approvals.toml, so no checkout may rewrite their line endings.
packaging/packs/licence-texts/** -text
