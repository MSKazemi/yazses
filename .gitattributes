# Byte-exact fixtures and traces: the determinism tests hash these files, and Git for Windows
# defaults to checking text out with CRLF, which made `test_the_checked_in_fixtures_use_unix_newlines_and_ascii`
# fail on the Windows runner. Pin them to LF on every OS.
tests/fixtures/eye_eval/** text eol=lf
tests/fixtures/eye_eval_runner/** text eol=lf
tests/fixtures/eye_eval_tasks/** text eol=lf
tests/fixtures/face_switch_traces/** text eol=lf
tests/fixtures/grounding_traces/** text eol=lf
tests/fixtures/face_switch_replay_report.json text eol=lf
tests/fixtures/grounding_replay_report.json text eol=lf
design/eye-control/validation-slots.json text eol=lf
design/eye-control/generated/** text eol=lf
# The Hugging Face benchmark export is hashed byte for byte (SHA256SUMS + export-metadata.json),
# and the tests compare a fresh export against the checkout. Git for Windows would check the CSVs
# out with CRLF and every file would read as drifted, so pin them to LF on every OS.
huggingface/benchmarks/data/** text eol=lf
# Each export row carries `source_sha256`, the hash of the raw bytes of its paper/results source,
# and seven of those files are stored with CRLF. Keep every source byte-exact on every OS (`-text`,
# like the licence texts below): a CRLF checkout would change every hash and the export would drift.
paper/results/** -text
# The HCI lab's manifest records the SHA-256 of its fixtures and schema, and `make_manifest.js --check`
# compares the manifest itself as a string, so a Windows checkout must not rewrite those three files.
# Name them, not the folder: a folder-wide `text` would also pin assets/logo.svg to LF while its
# source, contrib/icons/yazses.svg, gets CRLF, and would force `text` onto any binary added later.
examples/hci-hf-lab/fixtures.js text eol=lf
examples/hci-hf-lab/fixtures.schema.json text eol=lf
examples/hci-hf-lab/fixtures.manifest.json text eol=lf
# Vendored licence texts for add-on packs: the build copies them only when their SHA-256
# matches licence-approvals.toml, so no checkout may rewrite their line endings.
packaging/packs/licence-texts/** -text
