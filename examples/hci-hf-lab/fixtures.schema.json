{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yazses-hci-lab-fixtures-1.0",
  "title": "YazSes HCI lab fixtures (schema 1.0)",
  "description": "Schema for fixtures.js, maintained in examples/hci-hf-lab/ (issue #699). All data is synthetic. Timeline events are listed in arrival order (seq); t_ms is the source timestamp.",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "consent",
    "license",
    "provenance",
    "generator",
    "thresholds",
    "desktop",
    "intents",
    "activation_kinds",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "synthetic": { "const": true },
    "license": { "const": "Apache-2.0", "description": "SPDX identifier." },
    "provenance": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "description": "How the data was produced; hand-authored, no random seed." },
    "notice": { "type": "string" },
    "thresholds": {
      "type": "object",
      "required": [
        "gaze_min_confidence",
        "max_age_ms",
        "voice_min_confidence",
        "activation_min_confidence",
        "emg_min_hold_ms",
        "blink_refractory_ms",
        "ambiguity_margin_pct"
      ],
      "properties": {
        "gaze_min_confidence": { "$ref": "#/$defs/confidence" },
        "max_age_ms": { "$ref": "#/$defs/ms" },
        "voice_min_confidence": { "$ref": "#/$defs/confidence" },
        "activation_min_confidence": {
          "type": "object",
          "propertyNames": { "enum": ["blink", "face_gesture", "emg_hold", "eeg_eog"] },
          "additionalProperties": { "$ref": "#/$defs/confidence" }
        },
        "emg_min_hold_ms": { "$ref": "#/$defs/ms" },
        "blink_refractory_ms": { "$ref": "#/$defs/ms" },
        "ambiguity_margin_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "A gaze-only target is ambiguous when the gaze point is within this many percent of another window."
        }
      }
    },
    "desktop": {
      "type": "object",
      "required": ["windows"],
      "properties": {
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "rect", "trusted"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "rect": {
                "type": "object",
                "required": ["x", "y", "w", "h"],
                "description": "Percent of the simulated desktop, 0..100.",
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "trusted": { "type": "boolean", "description": "False: the resolver never proposes an action on this window." }
            }
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "destructive"],
        "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "destructive": { "type": "boolean" } }
      }
    },
    "activation_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "experimental"],
        "properties": {
          "id": { "enum": ["none", "blink", "face_gesture", "emg_hold", "eeg_eog"] },
          "label": { "type": "string" },
          "experimental": { "type": "boolean" }
        }
      }
    },
    "scenarios": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/scenario" } },
    "consent": {
      "type": "object",
      "required": ["required", "reason"],
      "properties": {
        "required": { "const": false, "description": "Consent is not applicable: no person is recorded." },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ms": { "type": "integer", "minimum": 0, "description": "Relative milliseconds; never a wall-clock time." },
    "decision": { "enum": ["accept", "ask_confirmation", "abstain", "stop"] },
    "modality": { "enum": ["voice_intent", "gaze", "face", "emg", "eeg_eog_experimental"] },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "synthetic",
        "negative_example",
        "modality",
        "inputs",
        "intended_target",
        "expected",
        "decision_at_ms",
        "timeline",
        "simulated_conditions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "synthetic": { "const": true },
        "negative_example": {
          "type": "boolean",
          "description": "True when the correct outcome is to refuse an activation that should not have fired."
        },
        "modality": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modality" } },
        "intended_target": {
          "type": ["string", "null"],
          "description": "Window id the simulated user meant; used only to count wrong-target accepts."
        },
        "simulated_conditions": {
          "type": "object",
          "required": ["lighting", "device"],
          "properties": { "lighting": { "type": "string" }, "device": { "type": "string" } }
        },
        "decision_at_ms": { "$ref": "#/$defs/ms" },
        "timeline": {
          "type": "array",
          "description": "Events in arrival order. seq is 1..n in that order. t_ms never decreases, except for an event flagged out_of_order, whose t_ms is earlier than an event that arrived before it. All t_ms are at or before decision_at_ms.",
          "items": {
            "type": "object",
            "required": ["seq", "t_ms", "source", "event"],
            "properties": {
              "t_ms": { "$ref": "#/$defs/ms" },
              "source": { "enum": ["system", "gaze", "voice", "activation"] },
              "event": { "type": "string" },
              "seq": { "type": "integer", "minimum": 1 },
              "out_of_order": { "type": "boolean" }
            }
          }
        },
        "inputs": {
          "type": "object",
          "required": ["emergency_stop", "gaze", "voice", "activation"],
          "properties": {
            "emergency_stop": { "type": "boolean" },
            "gaze": {
              "type": "object",
              "required": ["connected", "x", "y", "confidence", "age_ms", "quality"],
              "properties": {
                "connected": { "type": "boolean" },
                "x": { "type": "number", "minimum": 0, "maximum": 100 },
                "y": { "type": "number", "minimum": 0, "maximum": 100 },
                "confidence": { "$ref": "#/$defs/confidenceOrUnknown" },
                "age_ms": { "$ref": "#/$defs/ms" },
                "quality": { "$ref": "#/$defs/quality" }
              }
            },
            "voice": {
              "type": "object",
              "required": ["intent", "confidence", "target_ref"],
              "properties": {
                "intent": { "type": ["string", "null"] },
                "confidence": { "$ref": "#/$defs/confidence" },
                "target_ref": { "type": ["string", "null"], "description": "Window id named aloud, or null for 'this'." }
              }
            },
            "activation": {
              "type": "object",
              "required": ["kind", "confidence", "age_ms", "hold_ms", "bounce_count", "bounce_gap_ms", "quality"],
              "properties": {
                "kind": { "enum": ["none", "blink", "face_gesture", "emg_hold", "eeg_eog"] },
                "confidence": { "$ref": "#/$defs/confidenceOrUnknown" },
                "age_ms": { "$ref": "#/$defs/ms" },
                "hold_ms": { "$ref": "#/$defs/ms" },
                "bounce_count": { "type": "integer", "minimum": 0 },
                "bounce_gap_ms": {
                  "oneOf": [
                    { "$ref": "#/$defs/ms" },
                    { "type": "null" }
                  ],
                  "description": "null when bounce_count is 0, a gap in ms when it is above 0. The validator enforces the pairing; the schema alone cannot express it."
                },
                "quality": { "$ref": "#/$defs/quality" }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "required": ["decision", "intent", "target", "outcome"],
          "properties": {
            "decision": { "$ref": "#/$defs/decision" },
            "intent": { "type": ["string", "null"], "description": "The intent candidate: the spoken intent, or null." },
            "target": {
              "type": ["string", "null"],
              "description": "The target candidate: a window id, or null when none is proposed."
            },
            "outcome": { "$ref": "#/$defs/outcome" }
          }
        }
      }
    },
    "confidenceOrUnknown": {
      "oneOf": [
        { "$ref": "#/$defs/confidence" },
        { "type": "null" }
      ],
      "description": "null means the confidence is unknown, which is not the same as zero."
    },
    "quality": {
      "enum": ["good", "degraded", "unknown"],
      "description": "Annotation for evaluators: good, or degraded (confidence below its threshold or older than max_age_ms), or unknown (no connected stream or an unknown confidence). The resolver decides from confidence and age."
    },
    "outcome": {
      "enum": ["previewed", "awaiting_confirmation", "nothing_proposed", "stopped"],
      "description": "The simulated, verified outcome. Nothing is ever executed."
    }
  }
}
